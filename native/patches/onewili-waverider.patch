+/* Decode one whitespace-delimited string when more response fields follow.
+ * The generated app-signal getter previously used ow__rest_str here, which
+ * consumed both the returned name and numeric value and made every valid
+ * response fail with OW_ERR_PROTOCOL. */
+static ow_status ow__tok_str(char** cur, char* buf, size_t cap) {
+    char* t;
+    size_t len;
+    if (!buf || cap == 0) return OW_ERR_ARG;
+    t = ow__tok(cur);
+    if (!t) return OW_ERR_PROTOCOL;
+    len = strlen(t);
+    if (len >= cap) return OW_ERR_BUFFER;
+    memcpy(buf, t, len + 1);
+    return OW_OK;
+}
