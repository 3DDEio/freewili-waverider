diff --git a/bsp/input/picpwr.c b/bsp/input/picpwr.c
index f11df13..3e938be 100644
--- a/bsp/input/picpwr.c
+++ b/bsp/input/picpwr.c
@@ -14,6 +14,7 @@
 static picpwr_cfg_t    s_cache;
 static absolute_time_t s_last_send;
 static bool            s_sent_any;
+static uint32_t        s_main_control_bits;

 bool picpwr_rails(uint32_t *rails_out)
 {
@@ -61,7 +62,8 @@ bool picpwr_send(const picpwr_cfg_t *cfg)
     clamped.awake &= PICPWR_ZONE_MASK_ALL;
     clamped.sleep &= PICPWR_ZONE_MASK_ALL;
     uint8_t frame[PICPWR_FRAME_LEN];
-    picpwr_frame_build(frame, &clamped);
+    clamped.awake |= s_main_control_bits;
+    picpwr_frame_build_main(frame, &clamped);
     (void)uartkbd_cmd_send(frame, sizeof frame);
     s_cache = clamped;
     s_last_send = get_absolute_time();
@@ -69,6 +71,28 @@ bool picpwr_send(const picpwr_cfg_t *cfg)
     return true;
 }

+bool picpwr_apply_main_awake_mask(uint32_t zone_mask)
+{
+    if (s_sent_any &&
+        absolute_time_diff_us(s_last_send, get_absolute_time())
+            < (int64_t)PICPWR_SPACING_MS * 1000)
+        return false;
+    zone_mask &= PICPWR_ZONE_MASK_MAIN;
+    s_main_control_bits = zone_mask & ~PICPWR_ZONE_MASK_ALL;
+    picpwr_cfg_t cfg = s_cache;
+    cfg.awake = zone_mask;
+    cfg.sleep &= PICPWR_ZONE_MASK_ALL;
+    uint8_t frame[PICPWR_FRAME_LEN];
+    picpwr_frame_build_main(frame, &cfg);
+    (void)uartkbd_cmd_send(frame, sizeof frame);
+    s_cache.awake = zone_mask & PICPWR_ZONE_MASK_ALL;
+    s_cache.sleep = cfg.sleep;
+    s_last_send = get_absolute_time();
+    s_sent_any = true;
+    DIAG("picpwr: MAIN awake mask applied=0x%x\n", (unsigned)zone_mask);
+    return true;
+}
+
 bool picpwr_ensure_awake(uint32_t zone_bits)
 {
     zone_bits &= PICPWR_ZONE_MASK_ALL;
